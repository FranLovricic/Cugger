@model Cugger.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Zaboravljena lozinka - Cugger";
}

<div class="auth-wrap">
    <div class="auth-card reveal">
        <div class="section-label">Recovery</div>
        <h1 class="auth-title">Zaboravio/la lozinku?</h1>
        <p class="auth-subtitle">Bez panike. Unesi email i poslat ćemo ti link za reset.</p>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="ti@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Pošalji link →</button>

            <p class="auth-foot">
                Sjetio si se? <a href="/login" class="link-arrow">Prijava <span>→</span></a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
