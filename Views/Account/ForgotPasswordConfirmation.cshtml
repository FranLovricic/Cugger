@{
    ViewData["Title"] = "Reset link generiran - Cugger";
    var resetLink = ViewBag.ResetLink as string;
}

<div class="auth-wrap">
    <div class="auth-card reveal">
        <div class="section-label">Recovery</div>
        <h1 class="auth-title">Provjeri inbox 📬</h1>
        <p class="auth-subtitle">
            Ako račun s tim emailom postoji, link za reset je generiran.
        </p>

        @if (!string.IsNullOrEmpty(resetLink))
        {
            <div class="alert alert-info" style="margin: 2rem 0;">
                <strong>Demo mode (lab projekt):</strong>
                <p style="margin: 0.5rem 0 1rem; font-size: 0.85rem; color: var(--text-secondary);">
                    U pravoj aplikaciji bi ovaj link bio poslan emailom. Za potrebe demoa, evo ga ovdje:
                </p>
                <a href="@resetLink" class="btn btn-primary" style="margin-top: 0.5rem;">
                    Otvori reset link →
                </a>
                <p style="margin-top: 1rem; font-size: 0.75rem; color: var(--text-muted); word-break: break-all;">
                    @resetLink
                </p>
            </div>
        }

        <p class="auth-foot">
            <a href="/login" class="link-arrow">Natrag na prijavu <span>→</span></a>
        </p>
    </div>
</div>
