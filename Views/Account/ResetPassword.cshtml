@model Cugger.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset lozinke - Cugger";
}

<div class="auth-wrap">
    <div class="auth-card reveal">
        <div class="section-label">New password</div>
        <h1 class="auth-title">Postavi novu lozinku 🔒</h1>
        <p class="auth-subtitle">Odaberi nešto što ćeš zapamtiti (i što je sigurno).</p>

        <form asp-action="ResetPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Spremi lozinku →</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
