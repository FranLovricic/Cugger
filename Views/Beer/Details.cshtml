@model Beer

@{
    ViewData["Title"] = $"{Model?.Name} - Pivo";
    var brewery = ViewBag.Brewery as Brewery;
    var checkIns = ViewBag.CheckIns as List<CheckIn>;
    var reviews = ViewBag.Reviews as List<Review>;
    var avgRating = ViewBag.AverageRating as double? ?? 0;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div style="display: flex; gap: 2rem; align-items: flex-start;">
                <div style="font-size: 5rem;">🍺</div>
                <div style="flex: 1;">
                    <h1 class="header-title">@Model.Name</h1>
                    @if (brewery != null)
                    {
                        <a href="/Brewery/Details/@brewery.Id" style="color: var(--primary); text-decoration: none; margin-bottom: 1rem; display: inline-block;">
                            <p style="color: var(--primary);">@brewery.Name</p>
                        </a>
                    }

                    <div class="header-meta">
                        <div class="header-meta-item">
                            <span class="header-meta-label">Stil</span>
                            <span class="header-meta-value">
                                <div class="tag tag-style">@Model.Style</div>
                            </span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Jačina (ABV)</span>
                            <span class="header-meta-value">@Model.ABV%</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Gorčina (IBU)</span>
                            <span class="header-meta-value">@Model.IBU</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Prosječna Ocjena</span>
                            <span class="header-meta-value">★ @avgRating.ToString("F1")/5.0</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p style="margin-top: 1.5rem; line-height: 1.6;">@Model.Description</p>
                    }
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/Beer" class="btn btn-secondary">Nazad na piva</a>
        </div>
    </div>
</div>

<!-- CHECK-INS SECTION -->
<div class="section">
    <h2 class="section-title">📍 Check-ini (@(checkIns?.Count ?? 0))</h2>
    
    @if (checkIns?.Any() == true)
    {
        <div class="grid grid-2">
            @foreach (var checkIn in checkIns)
            {
                <a href="/CheckIn/Details/@checkIn.Id" style="text-decoration: none; color: inherit;">
                    <div class="checkin-card">
                        <div class="checkin-header">
                            <div class="checkin-user">
                                <div class="avatar avatar-sm">
                                    <img src="https://ui-avatars.com/api/?name=User@(checkIn.UserId)&background=F59E0B&color=fff" alt="User" />
                                </div>
                                <div>
                                    <div class="checkin-user-name">Korisnik #@checkIn.UserId</div>
                                    <div class="checkin-user-time">@checkIn.CreatedAt.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="checkin-beer">
                            <div class="checkin-beer-content">
                                <div class="checkin-beer-icon">📍 Venue #@checkIn.VenueId</div>
                                @if (!string.IsNullOrEmpty(checkIn.Comment))
                                {
                                    <div class="checkin-info">
                                        <p style="font-style: italic;">@checkIn.Comment</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="checkin-footer">
                            <div class="checkin-rating">
                                <span>★</span>
                                <span>@checkIn.Rating.ToString("F1")</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty">
            <div class="section-empty-icon">📭</div>
            <p>Nema check-inova za ovo pivo.</p>
        </div>
    }
</div>

<!-- REVIEWS SECTION -->
<div class="section">
    <h2 class="section-title">⭐ Recenzije (@(reviews?.Count ?? 0))</h2>
    
    @if (reviews?.Any() == true)
    {
        <div class="grid grid-2">
            @foreach (var review in reviews)
            {
                <a href="/Review/Details/@review.Id" style="text-decoration: none; color: inherit;">
                    <div class="card">
                        <div class="card-header">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span>Korisnik #@review.UserId</span>
                                <span style="color: var(--warning);">★ @review.Rating.ToString("F1")</span>
                            </div>
                            <div style="font-size: 0.875rem; color: var(--gray); margin-top: 0.5rem;">
                                @review.CreatedAt.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                        <div class="card-body">
                            <p style="font-style: italic;">@review.Comment</p>
                        </div>
                        <div class="card-footer">
                            <span style="font-size: 0.875rem; color: var(--gray);">👍 @review.Likes likova</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty">
            <div class="section-empty-icon">📝</div>
            <p>Nema recenzija.</p>
        </div>
    }
</div>
