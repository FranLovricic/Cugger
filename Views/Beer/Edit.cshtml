@model Cugger.Models.ViewModels.CreateBeerViewModel

@{
    ViewData["Title"] = $"Uredi: {Model.Name} - Cugger";
    var breweries = ViewBag.Breweries as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var beerId = (int)ViewBag.BeerId;
}

<div class="auth-wrap" style="align-items: flex-start;">
    <div class="auth-card reveal" style="max-width: 640px;">
        <div class="section-label">Uređivanje</div>
        <h1 class="auth-title">Uredi pivo 🍺</h1>
        <p class="auth-subtitle">Ispravi detalje ako su pogrešni.</p>

        <form asp-action="Edit" asp-route-id="@beerId" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="BreweryId" class="form-label"></label>
                <partial name="_Controls/_AutocompleteSelect" model='new Cugger.Models.ViewModels.AutocompleteSelectViewModel {
                    FieldName = "BreweryId",
                    Endpoint = "/api/lookup/breweries",
                    Placeholder = "Traži pivovaru...",
                    InitialValueId = Model.BreweryId,
                    InitialLabel = breweries?.FirstOrDefault(x => x.Value == Model.BreweryId.ToString())?.Text }' />
                <span asp-validation-for="BreweryId" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Style" class="form-label"></label>
                <select asp-for="Style" class="form-input" asp-items="Html.GetEnumSelectList<Cugger.Models.BeerStyle>()"></select>
                <span asp-validation-for="Style" class="form-error"></span>
            </div>

            <div class="form-row form-row-grid">
                <div>
                    <label asp-for="ABV" class="form-label"></label>
                    <input asp-for="ABV" type="number" step="0.1" min="0" max="25" class="form-input" />
                    <span asp-validation-for="ABV" class="form-error"></span>
                </div>
                <div>
                    <label asp-for="IBU" class="form-label"></label>
                    <input asp-for="IBU" type="number" min="0" max="200" class="form-input" />
                    <span asp-validation-for="IBU" class="form-error"></span>
                </div>
            </div>

            <div class="form-row">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-input" rows="4"></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" type="url" class="form-input" />
                <span asp-validation-for="ImageUrl" class="form-error"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                <a href="/pivo/@beerId" class="btn btn-secondary" style="flex: 1;">Odustani</a>
                <button type="submit" class="btn btn-primary" style="flex: 2;">Spremi izmjene →</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
