@model List<Beer>

@{
    ViewData["Title"] = "Piva - Cugger";
    ViewBag.Breadcrumbs = new[] {
        new { Title = "Dashboard", Url = "/", IsCurrent = false },
        new { Title = "Piva", Url = "/Beer", IsCurrent = true }
    };
}

<div class="header">
    <div class="header-main">
        <h1 class="page-title">🍺 Sve Piva</h1>
        <p class="page-subtitle">Istražite našu kolekciju piva s detaljima o stilovima, ABV i IBU vrijednostima</p>
    </div>
</div>

@if (Model?.Any() == true)
{
    <div class="grid grid-4">
        @foreach (var beer in Model)
        {
            <a href="/Beer/Details/@beer.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-body">
                        <div style="font-size: 2rem; text-align: center; margin-bottom: 1rem;">🍺</div>
                        <h3 class="card-title" style="font-size: 1.1rem; margin-bottom: 0.75rem;">@beer.Name</h3>
                        <div class="tag tag-style" style="display: inline-block; margin-bottom: 1rem;">@beer.Style</div>
                        <div style="font-size: 0.875rem; color: var(--gray); margin-bottom: 0.5rem;">
                            @beer.ABV% ABV
                        </div>
                        <div style="font-size: 0.875rem; color: var(--gray); margin-bottom: 1rem;">
                            @beer.IBU IBU
                        </div>
                        <div style="padding-top: 1rem; border-top: 1px solid var(--light-gray); font-weight: 600; color: var(--primary);">
                            Pivovara #@beer.BreweryId
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="section-empty">
        <div class="section-empty-icon">🍺</div>
        <p>Nema piva.</p>
    </div>
}
