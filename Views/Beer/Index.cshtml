@model List<Beer>

@{
    ViewData["Title"] = "Piva - Cugger";
    ViewBag.Breadcrumbs = new[] {
        new { Title = "Dashboard", Url = "/", IsCurrent = false },
        new { Title = "Piva", Url = "/Beer", IsCurrent = true }
    };
}

<div class="page-header">
    <div class="section-label">Kolekcija</div>
    <h1 class="page-title">Piva</h1>
    <p class="page-subtitle">Istražite stilove, okuse i pivovare iz cijelog svijeta.</p>
</div>

@if (Model?.Any() == true)
{
    <div class="grid grid-4 stagger">
        @foreach (var beer in Model)
        {
            <a href="/Beer/Details/@beer.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-body" style="text-align: center; padding: 2rem 1.5rem;">
                        <div style="font-size: 2.5rem; margin-bottom: 1rem;">🍺</div>
                        <h3 class="card-title" style="font-size: 1.05rem; margin-bottom: 0.75rem;">@beer.Name</h3>
                        <div class="tag tag-style" style="margin-bottom: 1rem;">@beer.Style</div>
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                            @beer.ABV% ABV · @beer.IBU IBU
                        </div>
                        <div style="padding-top: 1rem; border-top: 1px solid var(--border); margin-top: 1rem;">
                            <span class="link-arrow" style="font-size: 0.8rem;">Pivovara #@beer.BreweryId <span>→</span></span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="section-empty">
        <div class="section-empty-icon">🍺</div>
        <p>Nema piva.</p>
    </div>
}
