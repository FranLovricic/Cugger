@model List<Beer>

@{
    ViewData["Title"] = "Piva - Cugger";
    var styles = Enum.GetValues<BeerStyle>();
    var selectedStyle = ViewBag.SelectedStyle as string;
}

<div class="page-header">
    <partial name="_Decor/_BeerTap" />
    <div class="section-label">Kolekcija</div>
    <h1 class="page-title">Piva</h1>
    <p class="page-subtitle">Istraži stilove, okuse i pivovare iz cijelog svijeta.</p>
    @if (User.IsInRole("Admin"))
    {
        <div style="margin-top: 1.5rem;">
            <a href="/Beer/Create" class="btn btn-primary">+ Dodaj pivo</a>
        </div>
    }
</div>

<!-- AJAX search + style filter -->
<form data-ajax-search="/api/search/beers" data-target="#beer-results" class="search-bar reveal" style="margin-bottom: 1.5rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži pivo po imenu ili opisu..."
        autocomplete="off" />
</form>

<div class="style-filter reveal" style="margin-bottom: 2.5rem;">
    <button type="button" class="filter-chip active" data-style-filter="">Svi</button>
    @foreach (var style in styles)
    {
        <button type="button" class="filter-chip" data-style-filter="@style">@style</button>
    }
</div>

<div id="beer-results">
    <partial name="_BeerGrid" model="Model" />
</div>

@section Scripts {
    <script>
        // Wire style filter chips to the AJAX search form
        (function () {
            const form = document.querySelector('form[data-ajax-search="/api/search/beers"]');
            if (!form) return;
            let hidden = form.querySelector('input[name="style"]');
            if (!hidden) {
                hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'style';
                form.appendChild(hidden);
            }
            document.querySelectorAll('[data-style-filter]').forEach(chip => {
                chip.addEventListener('click', function () {
                    document.querySelectorAll('[data-style-filter]').forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    hidden.value = this.dataset.styleFilter;
                    hidden.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });
        })();
    </script>
}
