@model Brewery

@{
    ViewData["Title"] = $"{Model?.Name} - Pivovara";
    var beers = ViewBag.Beers as List<Beer>;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div class="section-label">Pivovara</div>
            <h1 class="header-title">@Model.Name</h1>
            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">📍 @Model.City, @Model.Country</p>

            <div class="header-meta">
                <div class="header-meta-item">
                    <span class="header-meta-label">Osnovano</span>
                    <span class="header-meta-value">@Model.FoundedYear</span>
                </div>
                <div class="header-meta-item">
                    <span class="header-meta-label">Piva</span>
                    <span class="header-meta-value">@(beers?.Count ?? 0)</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p style="margin-top: 1.5rem; line-height: 1.7; color: var(--text-secondary);">@Model.Description</p>
            }
        </div>
        <div class="header-actions">
            <a href="/Brewery" class="btn btn-secondary">← Nazad</a>
            @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
            {
                <a href="@Model.WebsiteUrl" target="_blank" class="btn btn-primary">Web stranica →</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a href="/Brewery/Edit/@Model.Id" class="btn btn-ghost btn-sm">Uredi</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;"
                      onsubmit="return confirm('Sigurno želiš obrisati ovu pivovaru? (samo ako nema piva u katalogu)');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Obriši</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- BEERS -->
<section class="section reveal">
    <div class="section-label">Kolekcija</div>
    <h2 class="section-title" style="font-size: 1.75rem;">Piva pivovare</h2>

    @if (beers?.Any() == true)
    {
        <div class="grid grid-4 stagger">
            @foreach (var beer in beers)
            {
                <a href="/pivo/@beer.Id" style="text-decoration: none; color: inherit;">
                    <div class="card beer-card" data-style="@beer.Style">
                        <div class="card-body" style="text-align: center; padding: 2rem 1.5rem;">
                            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🍺</div>
                            <h3 class="card-title" style="font-size: 1.05rem; margin-bottom: 0.75rem;">@beer.Name</h3>
                            <div class="tag tag-style" style="margin-bottom: 1rem;">@beer.Style</div>
                            @if (beer.RatingCount > 0)
                            {
                                <div style="margin-bottom: 0.75rem; color: var(--warning); font-weight: 700;">
                                    ★ @beer.AverageRating.ToString("F1")
                                </div>
                            }
                            <div style="font-size: 0.85rem; color: var(--text-muted);">@beer.ABV% ABV · @beer.IBU IBU</div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty"><div class="section-empty-icon">🍺</div><p>Nema piva iz ove pivovare.</p></div>
    }
</section>
