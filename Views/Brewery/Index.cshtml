@model List<Brewery>

@{
    ViewData["Title"] = "Pivovare - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_BrewerySmoke" />
    <div class="section-label">Proizvođači</div>
    <h1 class="page-title">Pivovare</h1>
    <p class="page-subtitle">Otkrij pivovare iz cijelog svijeta.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="margin-top: 1.5rem;">
            <a href="/Brewery/Create" class="btn btn-primary">+ Dodaj pivovaru</a>
        </div>
    }
</div>

<form data-ajax-search="/api/search/breweries" data-target="#brewery-results" class="search-bar reveal" style="margin-bottom: 2rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži po imenu, gradu, državi..."
        autocomplete="off" />
</form>

<div id="brewery-results">
    <partial name="_BreweryGrid" model="Model" />
</div>
