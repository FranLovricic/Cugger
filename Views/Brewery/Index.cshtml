@model List<Brewery>

@{
    ViewData["Title"] = "Pivovare - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_BrewerySmoke" />
    <div class="section-label">Proizvođači</div>
    <h1 class="page-title">Pivovare</h1>
    <p class="page-subtitle">Otkrij pivovare iz cijelog svijeta.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="margin-top: 1.5rem;">
            <a href="/Brewery/Create" class="btn btn-primary">+ Dodaj pivovaru</a>
        </div>
    }
</div>

@if (Model?.Any() == true)
{
    <div class="grid grid-3 stagger">
        @foreach (var brewery in Model)
        {
            <a href="/pivovara/@brewery.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">@brewery.Name</h3>
                    </div>
                    <div class="card-body">
                        <div style="margin-bottom: 1rem;">
                            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">📍 @brewery.City, @brewery.Country</p>
                            <p style="font-size: 0.85rem; color: var(--text-muted);">Osnovano @brewery.FoundedYear</p>
                        </div>
                        @if (!string.IsNullOrEmpty(brewery.Description))
                        {
                            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">@brewery.Description</p>
                        }
                    </div>
                    <div class="card-footer">
                        <span class="link-arrow" style="font-size: 0.8rem;">Pogledaj <span>→</span></span>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="section-empty"><div class="section-empty-icon">🏭</div><p>Nema pivovara.</p></div>
}
