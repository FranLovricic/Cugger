@model Cugger.Models.ViewModels.CreateCheckInViewModel

@{
    ViewData["Title"] = "Novi check-in - Cugger";
    var beers = ViewBag.Beers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var venues = ViewBag.Venues as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="auth-wrap" style="align-items: flex-start;">
    <div class="auth-card reveal" style="max-width: 640px;">
        <div class="section-label">Toast 🍻</div>
        <h1 class="auth-title">Što piješ?</h1>
        <p class="auth-subtitle">Podijeli što ovog trenutka kušaš sa zajednicom.</p>

        <form asp-action="Create" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="BeerId" class="form-label"></label>
                <select asp-for="BeerId" asp-items="beers" class="form-input">
                    <option value="">— odaberi pivo —</option>
                </select>
                <span asp-validation-for="BeerId" class="form-error"></span>
                <small style="display:block; margin-top: 0.5rem; color: var(--text-muted); font-size: 0.8rem;">
                    Nema piva? <a href="/Beer/Create" class="forgot-link">Dodaj novo →</a>
                </small>
            </div>

            <div class="form-row">
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" asp-items="venues" class="form-input">
                    <option value="">— odaberi lokal —</option>
                </select>
                <span asp-validation-for="VenueId" class="form-error"></span>
                <small style="display:block; margin-top: 0.5rem; color: var(--text-muted); font-size: 0.8rem;">
                    Nema lokala? <a href="/Venue/Create" class="forgot-link">Dodaj novi →</a>
                </small>
            </div>

            <div class="form-row">
                <label asp-for="Rating" class="form-label">Ocjena (★ <span id="rating-display">@Model.Rating.ToString("F1")</span>)</label>
                <input asp-for="Rating" type="range" min="0.5" max="5" step="0.5"
                       class="rating-slider" oninput="document.getElementById('rating-display').textContent = parseFloat(this.value).toFixed(1)" />
                <div class="rating-scale">
                    <span>0.5</span><span>1.5</span><span>2.5</span><span>3.5</span><span>4.5</span><span>5.0</span>
                </div>
                <span asp-validation-for="Rating" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-input" rows="3" placeholder="Kako ti je sjelo? (opcionalno)"></textarea>
                <span asp-validation-for="Comment" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="CheckInDate" class="form-label"></label>
                <input asp-for="CheckInDate" type="date" class="form-input" />
                <span asp-validation-for="CheckInDate" class="form-error"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                <a href="/feed" class="btn btn-secondary" style="flex: 1;">Odustani</a>
                <button type="submit" class="btn btn-primary" style="flex: 2;">Pošalji check-in 🍻</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
