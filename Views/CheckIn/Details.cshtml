@model CheckIn

@{
    ViewData["Title"] = "Check-in Detalji";
    var user = ViewBag.User as User;
    var beer = ViewBag.Beer as Beer;
    var venue = ViewBag.Venue as Venue;
    var brewery = ViewBag.Brewery as Brewery;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div style="display: flex; gap: 2rem; align-items: flex-start;">
                <div style="font-size: 4rem;">📍</div>
                <div style="flex: 1;">
                    <h1 class="header-title">Check-in Detaljno</h1>
                    <p style="color: var(--gray); margin-bottom: 1.5rem;">
                        @if (user != null)
                        {
                            <a href="/User/Details/@user.Id" style="color: var(--primary); text-decoration: none;">@user.FirstName @user.LastName</a>
                        }
                        je ocijenjio pivo na
                        @if (venue != null)
                        {
                            <a href="/Venue/Details/@venue.Id" style="color: var(--primary); text-decoration: none;">@venue.Name</a>
                        }
                    </p>

                    <div class="header-meta">
                        <div class="header-meta-item">
                            <span class="header-meta-label">Datum Check-ina</span>
                            <span class="header-meta-value">@Model.CheckInDate.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Ocjena</span>
                            <span class="header-meta-value" style="color: var(--warning);">★ @Model.Rating.ToString("F1")/5.0</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Kreirano</span>
                            <span class="header-meta-value">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/CheckIn" class="btn btn-secondary">Nazad na check-ine</a>
        </div>
    </div>
</div>

<!-- BEER SECTION -->
@if (beer != null)
{
    <div class="section">
        <h2 class="section-title">🍺 Pivo</h2>
        <div class="grid grid-2">
            <div>
                <div class="card">
                    <div class="card-body">
                        <div style="font-size: 2.5rem; text-align: center; margin-bottom: 1rem;">🍺</div>
                        <h3 class="card-title" style="font-size: 1.125rem; margin-bottom: 1rem;">@beer.Name</h3>
                        <div class="tag tag-style" style="display: inline-block; margin-bottom: 1rem;">@beer.Style</div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem;">
                            <div>
                                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gray);">Jačina</div>
                                <div style="font-size: 1.25rem; font-weight: 600;">@beer.ABV%</div>
                            </div>
                            <div>
                                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--gray);">Gorčina</div>
                                <div style="font-size: 1.25rem; font-weight: 600;">@beer.IBU</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Beer/Details/@beer.Id" style="color: var(--primary); text-decoration: none;">Pogledaj pivo →</a>
                    </div>
                </div>
            </div>
            @if (brewery != null)
            {
                <div>
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" style="margin-bottom: 0;">@brewery.Name</h3>
                        </div>
                        <div class="card-body">
                            <p style="margin-bottom: 1rem;">@brewery.City, @brewery.Country</p>
                            <p style="font-size: 0.875rem; color: var(--gray);">@brewery.Description</p>
                        </div>
                        <div class="card-footer">
                            <a href="/Brewery/Details/@brewery.Id" style="color: var(--primary); text-decoration: none;">Pogledaj pivovaru →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- VENUE SECTION -->
@if (venue != null)
{
    <div class="section">
        <h2 class="section-title">📍 Lokacija</h2>
        <div class="card">
            <div class="card-header">
                <h3 class="card-title" style="margin-bottom: 0;">@venue.Name</h3>
            </div>
            <div class="card-body">
                <p style="margin-bottom: 0.5rem;"><strong>Adresa:</strong> @venue.Address</p>
                <p style="margin-bottom: 0.5rem;"><strong>Grad:</strong> @venue.City, @venue.Country</p>
                <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 1rem;">
                    📍 @venue.Latitude, @venue.Longitude
                </p>
            </div>
            <div class="card-footer">
                <a href="/Venue/Details/@venue.Id" style="color: var(--primary); text-decoration: none;">Pogledaj lokaciju →</a>
            </div>
        </div>
    </div>
}

<!-- COMMENT SECTION -->
@if (!string.IsNullOrEmpty(Model.Comment))
{
    <div class="section">
        <h2 class="section-title">💬 Komentar</h2>
        <div class="card">
            <div class="card-body">
                <p style="font-style: italic; line-height: 1.6;">@Model.Comment</p>
            </div>
        </div>
    </div>
}
