@model CheckIn

@{
    ViewData["Title"] = "Check-in Detalji";
    var user = ViewBag.User as User;
    var beer = ViewBag.Beer as Beer;
    var venue = ViewBag.Venue as Venue;
    var brewery = ViewBag.Brewery as Brewery;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div style="display: flex; gap: 2rem; align-items: flex-start;">
                <div style="font-size: 3.5rem;">📍</div>
                <div style="flex: 1;">
                    <div class="section-label">Check-in</div>
                    <h1 class="header-title">Check-in detalji</h1>
                    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
                        @if (user != null)
                        {
                            <a href="/User/Details/@user.Id" class="link-arrow" style="display: inline-flex;">@user.FirstName @user.LastName <span>→</span></a>
                        }
                        <span style="color: var(--text-muted);"> je ocijenjio pivo na </span>
                        @if (venue != null)
                        {
                            <a href="/Venue/Details/@venue.Id" class="link-arrow" style="display: inline-flex;">@venue.Name <span>→</span></a>
                        }
                    </p>

                    <div class="header-meta">
                        <div class="header-meta-item">
                            <span class="header-meta-label">Datum</span>
                            <span class="header-meta-value">@Model.CheckInDate.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Ocjena</span>
                            <span class="header-meta-value" style="color: var(--warning);">★ @Model.Rating.ToString("F1")</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Kreirano</span>
                            <span class="header-meta-value">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/feed" class="btn btn-secondary">← Nazad</a>
            @if (ViewBag.IsOwner == true)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;"
                      onsubmit="return confirm('Sigurno želiš obrisati ovaj check-in?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Obriši</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- BEER & BREWERY -->
@if (beer != null)
{
    <section class="section reveal">
        <div class="section-label">Pivo</div>
        <h2 class="section-title" style="font-size: 1.75rem;">@beer.Name</h2>
        <div class="grid grid-2 stagger">
            <div>
                <div class="card">
                    <div class="card-body" style="text-align: center; padding: 2rem;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">🍺</div>
                        <h3 class="card-title" style="margin-bottom: 0.75rem;">@beer.Name</h3>
                        <div class="tag tag-style" style="margin-bottom: 1rem;">@beer.Style</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem;">
                            <div>
                                <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted);">ABV</div>
                                <div style="font-size: 1.25rem; font-weight: 700; color: var(--white);">@beer.ABV%</div>
                            </div>
                            <div>
                                <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted);">IBU</div>
                                <div style="font-size: 1.25rem; font-weight: 700; color: var(--white);">@beer.IBU</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Beer/Details/@beer.Id" class="link-arrow" style="font-size: 0.85rem;">Pogledaj pivo <span>→</span></a>
                    </div>
                </div>
            </div>
            @if (brewery != null)
            {
                <div>
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">@brewery.Name</h3></div>
                        <div class="card-body">
                            <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">📍 @brewery.City, @brewery.Country</p>
                            <p style="font-size: 0.85rem; color: var(--text-muted);">@brewery.Description</p>
                        </div>
                        <div class="card-footer">
                            <a href="/Brewery/Details/@brewery.Id" class="link-arrow" style="font-size: 0.85rem;">Pogledaj pivovaru <span>→</span></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<div class="divider"></div>

<!-- VENUE -->
@if (venue != null)
{
    <section class="section reveal">
        <div class="section-label">Lokacija</div>
        <h2 class="section-title" style="font-size: 1.75rem;">@venue.Name</h2>
        <div class="card">
            <div class="card-body">
                <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">📍 @venue.Address</p>
                <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">@venue.City, @venue.Country</p>
                <p style="font-size: 0.8rem; color: var(--text-muted);">@venue.Latitude, @venue.Longitude</p>
            </div>
            <div class="card-footer">
                <a href="/Venue/Details/@venue.Id" class="link-arrow" style="font-size: 0.85rem;">Pogledaj lokaciju <span>→</span></a>
            </div>
        </div>
    </section>
}

<!-- COMMENT -->
@if (!string.IsNullOrEmpty(Model.Comment))
{
    <div class="divider"></div>
    <section class="section reveal">
        <div class="section-label">Komentar</div>
        <div class="card">
            <div class="card-body" style="padding: 2rem;">
                <p style="font-style: italic; line-height: 1.7; font-size: 1.1rem; color: var(--text-secondary);">@Model.Comment</p>
            </div>
        </div>
    </section>
}
