@model List<CheckIn>

@{
    ViewData["Title"] = "Check-ini - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_ClinkingGlasses" />
    <div class="section-label">Aktivnost</div>
    <h1 class="page-title">Feed</h1>
    <p class="page-subtitle">Što zajednica upravo pije.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="margin-top: 1.5rem;">
            <a href="/CheckIn/Create" class="btn btn-primary">+ Novi check-in 🍻</a>
        </div>
    }
</div>

<form data-ajax-search="/api/search/checkins" data-target="#checkin-results" class="search-bar reveal" style="margin-bottom: 2rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži po komentaru, pivu, korisniku ili lokalu..."
        autocomplete="off" />
</form>

<div id="checkin-results">
    <partial name="_CheckInGrid" model="Model" />
</div>
