@model Friendship

@{
    ViewData["Title"] = "Prijateljstvo Detaljno";
    var fromUser = ViewBag.FromUser as User;
    var toUser = ViewBag.ToUser as User;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <h1 class="header-title">👥 Prijateljstvo</h1>
            <p style="color: var(--gray); margin-bottom: 1.5rem;">Veza između korisnika</p>

            <div class="header-meta">
                <div class="header-meta-item">
                    <span class="header-meta-label">Kreirano</span>
                    <span class="header-meta-value">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/Friendship" class="btn btn-secondary">Nazad na prijateljstva</a>
        </div>
    </div>
</div>

<!-- FRIENDSHIP DETAILS SECTION -->
<div class="section">
    <h2 class="section-title">👥 Korisnici</h2>
    
    <div class="grid grid-2">
        @if (fromUser != null)
        {
            <a href="/User/Details/@fromUser.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-body" style="text-align: center;">
                        <div class="avatar avatar-lg" style="margin: 0 auto 1rem;">
                            <img src="@fromUser.AvatarUrl" alt="@fromUser.FirstName" />
                        </div>
                        <h3 class="card-title" style="font-size: 1.1rem; margin-bottom: 0.5rem;">@fromUser.FirstName @fromUser.LastName</h3>
                        <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 1rem;">@@fromUser.Username</p>
                        @if (!string.IsNullOrEmpty(fromUser.Bio))
                        {
                            <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 0;">@fromUser.Bio</p>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="/User/Details/@fromUser.Id" style="color: var(--primary); text-decoration: none;">Pogledaj profil →</a>
                    </div>
                </div>
            </a>
        }

        @if (toUser != null)
        {
            <a href="/User/Details/@toUser.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-body" style="text-align: center;">
                        <div class="avatar avatar-lg" style="margin: 0 auto 1rem;">
                            <img src="@toUser.AvatarUrl" alt="@toUser.FirstName" />
                        </div>
                        <h3 class="card-title" style="font-size: 1.1rem; margin-bottom: 0.5rem;">@toUser.FirstName @toUser.LastName</h3>
                        <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 1rem;">@@toUser.Username</p>
                        @if (!string.IsNullOrEmpty(toUser.Bio))
                        {
                            <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 0;">@toUser.Bio</p>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="/User/Details/@toUser.Id" style="color: var(--primary); text-decoration: none;">Pogledaj profil →</a>
                    </div>
                </div>
            </a>
        }
    </div>
</div>
