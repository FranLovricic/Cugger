@model List<Friendship>

@{
    ViewData["Title"] = "Prijateljstva - Cugger";
}

<div class="header">
    <div class="header-main">
        <h1 class="page-title">👥 Prijateljstva</h1>
        <p class="page-subtitle">Istražite društvene veze zajednice</p>
    </div>
</div>

@if (Model?.Any() == true)
{
    <div class="grid grid-3">
        @foreach (var friendship in Model)
        {
            <a href="/Friendship/Details/@friendship.Id" style="text-decoration: none; color: inherit;">
                <div class="card">
                    <div class="card-body" style="text-align: center;">
                        <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                            <div class="avatar avatar-md">
                                <img src="https://ui-avatars.com/api/?name=User@(friendship.FromUserId)&background=F59E0B&color=fff" alt="User" />
                            </div>
                            <div style="font-size: 1.5rem; color: var(--primary);">↔</div>
                            <div class="avatar avatar-md">
                                <img src="https://ui-avatars.com/api/?name=User@(friendship.ToUserId)&background=D97706&color=fff" alt="User" />
                            </div>
                        </div>
                        <p style="font-size: 0.875rem; margin-bottom: 0;">Korisnik #@friendship.FromUserId</p>
                        <p style="font-size: 0.875rem; color: var(--gray); margin-bottom: 1rem;">↔</p>
                        <p style="font-size: 0.875rem; margin-bottom: 0;">Korisnik #@friendship.ToUserId</p>
                        <p style="font-size: 0.75rem; color: var(--gray); margin-top: 1rem;">@friendship.CreatedAt.ToString("dd.MM.yyyy")</p>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="section-empty">
        <div class="section-empty-icon">👥</div>
        <p>Nema prijateljstava.</p>
    </div>
}
