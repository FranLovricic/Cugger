@{
    ViewData["Title"] = "Cugger — Discover Beer Culture";
    var recentCheckIns = ViewBag.RecentCheckIns as List<CheckIn>;
    var topBeers = ViewBag.TopRatedBeers as List<Beer>;
    var activeUsers = ViewBag.MostActiveUsers as List<AppUser>;
}

<!-- HERO -->
<section class="hero">
    <!-- Floating hops decoration -->
    <svg class="hero-hop h1" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="#65A30D">
            <ellipse cx="50" cy="20" rx="14" ry="8" />
            <ellipse cx="38" cy="35" rx="14" ry="8" />
            <ellipse cx="62" cy="35" rx="14" ry="8" />
            <ellipse cx="30" cy="52" rx="14" ry="8" />
            <ellipse cx="50" cy="52" rx="14" ry="8" />
            <ellipse cx="70" cy="52" rx="14" ry="8" />
            <ellipse cx="38" cy="68" rx="14" ry="8" />
            <ellipse cx="62" cy="68" rx="14" ry="8" />
            <ellipse cx="50" cy="84" rx="12" ry="8" />
        </g>
    </svg>
    <svg class="hero-hop h2" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="#84CC16">
            <ellipse cx="50" cy="20" rx="14" ry="8" />
            <ellipse cx="38" cy="35" rx="14" ry="8" />
            <ellipse cx="62" cy="35" rx="14" ry="8" />
            <ellipse cx="30" cy="52" rx="14" ry="8" />
            <ellipse cx="50" cy="52" rx="14" ry="8" />
            <ellipse cx="70" cy="52" rx="14" ry="8" />
            <ellipse cx="50" cy="68" rx="14" ry="8" />
        </g>
    </svg>
    <svg class="hero-hop h3" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="#A3E635">
            <ellipse cx="50" cy="25" rx="14" ry="8" />
            <ellipse cx="38" cy="42" rx="14" ry="8" />
            <ellipse cx="62" cy="42" rx="14" ry="8" />
            <ellipse cx="50" cy="60" rx="14" ry="8" />
            <ellipse cx="50" cy="76" rx="12" ry="8" />
        </g>
    </svg>

    <div class="hero-content">
        <div class="hero-eyebrow">Beer Tracking Platform</div>
        <h1 class="hero-title">
            Discover.<br />
            Rate.<br />
            <span class="accent">Share.</span>
        </h1>
        <p class="hero-description">
            Prati svako pivo, podijeli iskustva i poveži se sa zajednicom koja voli istu stvar — dobro pivo.
        </p>
        <div class="hero-cta">
            <a href="/Beer" class="btn btn-primary">Istraži piva →</a>
            <a href="/feed" class="btn btn-secondary">Pregledaj feed</a>
        </div>

        <!-- Quick search -->
        <form action="/pretraga" method="get" class="search-bar hero-search">
            <input
                type="search"
                name="q"
                class="search-input"
                placeholder="🔍 Traži pivo, stil ili pivovaru..."
                autocomplete="off" />
            <button type="submit" class="btn btn-primary">Idi</button>
        </form>
    </div>

    <div class="hero-visual">
        <partial name="_BeerMug" />
    </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
    <div class="marquee">
        <span class="marquee-item">IPA</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Stout</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Lager</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Pale Ale</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Wheat Beer</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Pilsner</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Porter</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Sour</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">IPA</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Stout</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Lager</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Pale Ale</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Wheat Beer</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Pilsner</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Porter</span>
        <span class="marquee-divider">●</span>
        <span class="marquee-item">Sour</span>
        <span class="marquee-divider">●</span>
    </div>
</div>

<!-- STATS -->
<div class="stats-row reveal">
    <div class="stat-card">
        <div class="stat-number" data-counter="@ViewBag.TotalUsers" data-suffix="+">0</div>
        <div class="stat-label">Korisnika</div>
    </div>
    <div class="stat-card">
        <div class="stat-number" data-counter="@ViewBag.TotalBeers" data-suffix="+">0</div>
        <div class="stat-label">Piva u bazi</div>
    </div>
    <div class="stat-card">
        <div class="stat-number" data-counter="@ViewBag.TotalBreweries" data-suffix="+">0</div>
        <div class="stat-label">Pivovara</div>
    </div>
    <div class="stat-card">
        <div class="stat-number" data-counter="@ViewBag.TotalCheckIns" data-suffix="+">0</div>
        <div class="stat-label">Check-inova</div>
    </div>
</div>

<!-- QUOTE -->
<div class="quote-block reveal">
    <p class="quote-text">
        "Pivo je dokaz da nas <span class="accent">Bog voli</span> i želi da budemo sretni."
    </p>
    <span class="quote-attr">— Benjamin Franklin</span>
</div>

<div class="divider"></div>

<!-- TOP RATED BEERS -->
<section class="section">
    <div class="reveal">
        <div class="section-label">Istaknuto</div>
        <h2 class="section-title">Najbolje ocijenjeno pivo</h2>
        <p class="section-subtitle">Piva koja je zajednica ocijenila najvišim ocjenama.</p>
    </div>

    @if (topBeers?.Any() == true)
    {
        <div class="grid grid-4 stagger">
            @foreach (var beer in topBeers)
            {
                <a href="/pivo/@beer.Id" style="text-decoration: none; color: inherit;">
                    <div class="card beer-card" data-style="@beer.Style">
                        <div class="card-body" style="text-align: center; padding: 2rem 1.5rem;">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">🍺</div>
                            <h3 class="card-title" style="font-size: 1.05rem; margin-bottom: 0.75rem;">@beer.Name</h3>
                            <div class="tag tag-style" style="margin-bottom: 1.25rem;">@beer.Style</div>
                            <div style="margin-bottom: 0.75rem; font-weight: 700; color: var(--warning); font-size: 1.1rem;">
                                ★ @beer.AverageRating.ToString("F1")
                                <span style="color: var(--text-muted); font-weight: 400; font-size: 0.8rem;">(@beer.RatingCount)</span>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">
                                @beer.ABV% ABV · @beer.IBU IBU
                            </div>
                            @if (beer.Brewery != null)
                            {
                                <div style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--text-muted);">
                                    @beer.Brewery.Name
                                </div>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<div class="divider"></div>

<!-- FEATURE BLOCKS -->
<div class="feature-block reveal">
    <div class="feature-text">
        <div class="section-label">Zajednica</div>
        <h3>Otkrij što pije tvoja ekipa</h3>
        <p>Feed u stvarnom vremenu. Pogledaj što tvoji prijatelji piju, gdje, i koliko im se sviđa.</p>
        <a href="/feed" class="link-arrow">Pogledaj feed <span>→</span></a>
    </div>
    <div class="feature-visual">🍻</div>
</div>

<div class="feature-block reveal">
    <div class="feature-text">
        <div class="section-label">Pivovare</div>
        <h3>Istraži pivovare sa cijelog svijeta</h3>
        <p>Od malih craft pivovara do velikih imena — pronađi svoju novu omiljenu pivovaru.</p>
        <a href="/Brewery" class="link-arrow">Pogledaj pivovare <span>→</span></a>
    </div>
    <div class="feature-visual">🏭</div>
</div>

<div class="divider"></div>

<!-- RECENT CHECK-INS -->
<section class="section">
    <div class="reveal">
        <div class="section-label">Aktivnost</div>
        <h2 class="section-title">Nedavni check-ini</h2>
        <p class="section-subtitle">Što zajednica upravo pije.</p>
    </div>

    @if (recentCheckIns?.Any() == true)
    {
        <div class="grid grid-2 stagger">
            @foreach (var checkIn in recentCheckIns)
            {
                <a href="/CheckIn/Details/@checkIn.Id" style="text-decoration: none; color: inherit;">
                    <div class="checkin-card">
                        <div class="checkin-header">
                            <div class="checkin-user">
                                <div class="avatar avatar-sm">
                                    <img src="@(checkIn.User?.AvatarUrl ?? "https://ui-avatars.com/api/?name=User")" alt="@checkIn.User?.Username" />
                                </div>
                                <div>
                                    <div class="checkin-user-name">@(checkIn.User?.FirstName) @(checkIn.User?.LastName)</div>
                                    <div class="checkin-user-time">@checkIn.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>

                        <div class="checkin-beer">
                            <div class="checkin-beer-content">
                                <div class="checkin-beer-icon">🍻</div>
                                <div class="checkin-info">
                                    <div class="checkin-beer-name">@(checkIn.Beer?.Name ?? "Pivo")</div>
                                    <div class="checkin-beer-meta">
                                        <span>📍 @(checkIn.Venue?.Name ?? "Lokacija")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(checkIn.Comment))
                                    {
                                        <div class="checkin-beer-venue">@checkIn.Comment</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="checkin-footer">
                            <div class="checkin-rating">
                                <span>★</span>
                                <span>@checkIn.Rating.ToString("F1")</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<div class="divider"></div>

<!-- ACTIVE USERS -->
<section class="section">
    <div class="reveal">
        <div class="section-label">Ljudi</div>
        <h2 class="section-title">Najaktivniji korisnici</h2>
        <p class="section-subtitle">Upoznaj ljude koji predvode zajednicu.</p>
    </div>

    @if (activeUsers?.Any() == true)
    {
        <div class="grid grid-3 stagger">
            @foreach (var user in activeUsers)
            {
                <a href="/korisnik/@user.Username" style="text-decoration: none; color: inherit;">
                    <div class="card">
                        <div class="card-body" style="text-align: center; padding: 2.5rem 1.5rem;">
                            <div class="avatar avatar-lg" style="margin: 0 auto 1.25rem;">
                                <img src="@user.AvatarUrl" alt="@user.FirstName" />
                            </div>
                            <h3 class="card-title" style="font-size: 1rem; margin-bottom: 0.25rem;">@user.FirstName @user.LastName</h3>
                            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0;">@@@user.Username</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- BOTTOM CTA -->
<div class="quote-block reveal" style="padding: 6rem 0;">
    <div class="section-label" style="text-align: center;">Spreman?</div>
    <p class="quote-text" style="margin-bottom: 2rem;">
        Pridruži se <span class="accent">zajednici</span> i počni pratiti svaki gutljaj.
    </p>
    <div style="text-align: center;">
        <a href="/Beer" class="btn btn-primary" style="font-size: 1rem; padding: 1rem 2.5rem;">Istraži piva →</a>
    </div>
</div>
