@model Cugger.Models.ViewModels.CreateReviewViewModel

@{
    ViewData["Title"] = "Uredi recenziju - Cugger";
    var beers = ViewBag.Beers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var reviewId = (int)ViewBag.ReviewId;
    var initialBeerLabel = beers?.FirstOrDefault(x => x.Value == Model.BeerId.ToString())?.Text;
}

<div class="auth-wrap" style="align-items: flex-start;">
    <div class="auth-card reveal" style="max-width: 640px;">
        <div class="section-label">Uređivanje</div>
        <h1 class="auth-title">Uredi recenziju 📝</h1>
        <p class="auth-subtitle">Doradi svoje mišljenje.</p>

        <form asp-action="Edit" asp-route-id="@reviewId" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="BeerId" class="form-label"></label>
                <partial name="_Controls/_AutocompleteSelect" model='new Cugger.Models.ViewModels.AutocompleteSelectViewModel {
                    FieldName = "BeerId",
                    Endpoint = "/api/lookup/beers",
                    Placeholder = "Traži pivo...",
                    InitialValueId = Model.BeerId,
                    InitialLabel = initialBeerLabel }' />
                <span asp-validation-for="BeerId" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Rating" class="form-label">Ocjena (★ <span id="rating-display">@Model.Rating.ToString("F1")</span>)</label>
                <input asp-for="Rating" type="range" min="0.5" max="5" step="0.5"
                       class="rating-slider" oninput="document.getElementById('rating-display').textContent = parseFloat(this.value).toFixed(1)" />
                <div class="rating-scale">
                    <span>0.5</span><span>1.5</span><span>2.5</span><span>3.5</span><span>4.5</span><span>5.0</span>
                </div>
                <span asp-validation-for="Rating" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-input" rows="6"></textarea>
                <span asp-validation-for="Comment" class="form-error"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                <a href="/Review/Details/@reviewId" class="btn btn-secondary" style="flex: 1;">Odustani</a>
                <button type="submit" class="btn btn-primary" style="flex: 2;">Spremi izmjene →</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
