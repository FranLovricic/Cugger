@model List<Review>

@{
    ViewData["Title"] = "Recenzije - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_FloatingStars" />
    <div class="section-label">Mišljenja</div>
    <h1 class="page-title">Recenzije</h1>
    <p class="page-subtitle">Čitaj recenzije piva od zajednice.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="margin-top: 1.5rem;">
            <a href="/Review/Create" class="btn btn-primary">+ Nova recenzija 📝</a>
        </div>
    }
</div>

<div style="display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
    <a href="/Review" class="filter-chip @(Context.Request.Path == "/Review" ? "active" : "")">Sve recenzije</a>
    <a href="/Review/Top" class="filter-chip @(Context.Request.Path == "/Review/Top" ? "active" : "")">🔥 Top liked</a>
</div>

<form data-ajax-search="/api/search/reviews" data-target="#review-results" class="search-bar reveal" style="margin-bottom: 2rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži po komentaru, pivu ili autoru..."
        autocomplete="off" />
</form>

<div id="review-results">
    <partial name="_ReviewGrid" model="Model" />
</div>
