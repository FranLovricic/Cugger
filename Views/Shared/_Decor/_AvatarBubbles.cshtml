@* Avatar circles popping in/out at staggered positions *@
<div class="page-decor">
    <svg class="avatars-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Avatar bubbles -->
        <g class="avatar-bubble a1">
            <circle cx="50" cy="60" r="18" fill="#F59E0B" />
            <text x="50" y="67" font-size="20" text-anchor="middle" fill="#1a120a" font-weight="700">D</text>
        </g>
        <g class="avatar-bubble a2">
            <circle cx="100" cy="50" r="22" fill="#FCD34D" />
            <text x="100" y="58" font-size="22" text-anchor="middle" fill="#1a120a" font-weight="700">M</text>
        </g>
        <g class="avatar-bubble a3">
            <circle cx="155" cy="65" r="18" fill="#D97706" />
            <text x="155" y="72" font-size="20" text-anchor="middle" fill="#fff" font-weight="700">A</text>
        </g>
        <g class="avatar-bubble a4">
            <circle cx="55" cy="130" r="20" fill="#B45309" />
            <text x="55" y="138" font-size="20" text-anchor="middle" fill="#fff" font-weight="700">L</text>
        </g>
        <g class="avatar-bubble a5">
            <circle cx="105" cy="145" r="22" fill="#FBBF24" />
            <text x="105" y="153" font-size="22" text-anchor="middle" fill="#1a120a" font-weight="700">P</text>
        </g>
        <g class="avatar-bubble a6">
            <circle cx="160" cy="135" r="18" fill="#92400E" />
            <text x="160" y="142" font-size="20" text-anchor="middle" fill="#fff" font-weight="700">K</text>
        </g>
    </svg>
</div>
