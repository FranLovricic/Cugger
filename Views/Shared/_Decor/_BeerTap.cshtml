@* Animated beer tap with falling drops and foaming glass below *@
<div class="page-decor">
    <svg class="tap-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Tap pipe -->
        <rect x="92" y="20" width="16" height="55" rx="3" fill="#92400E" />
        <!-- Tap handle (top) -->
        <rect x="80" y="10" width="40" height="14" rx="4" fill="#FCD34D" />
        <rect x="95" y="0"  width="10" height="14" rx="2" fill="#92400E" />
        <!-- Tap nozzle -->
        <rect x="86" y="72" width="28" height="12" rx="3" fill="#B45309" />
        <ellipse cx="100" cy="84" rx="10" ry="3" fill="#7C2D12" />

        <!-- Falling drops -->
        <ellipse class="tap-drop d1" cx="100" cy="90"  rx="3.5" ry="5" />
        <ellipse class="tap-drop d2" cx="100" cy="90"  rx="3"   ry="4.5" />
        <ellipse class="tap-drop d3" cx="100" cy="90"  rx="3.5" ry="5" />
        <ellipse class="tap-drop d4" cx="100" cy="90"  rx="3"   ry="4" />

        <!-- Glass underneath -->
        <path d="M 70 175 L 75 130 L 125 130 L 130 175 Z"
              fill="rgba(254, 243, 199, 0.1)"
              stroke="rgba(254, 243, 199, 0.4)" stroke-width="2" />

        <!-- Liquid in glass -->
        <g class="tap-glass-foam">
            <path d="M 75 175 L 78 145 L 122 145 L 125 175 Z" fill="#F59E0B" opacity="0.85" />
            <ellipse cx="100" cy="145" rx="22" ry="3" fill="#FEF3C7" />
        </g>
    </svg>
</div>
