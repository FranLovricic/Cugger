@* Brewery silhouette with rising smoke from chimneys *@
<div class="page-decor">
    <svg class="brewery-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Smoke puffs -->
        <circle class="smoke-puff s1" cx="60"  cy="100" r="10" />
        <circle class="smoke-puff s2" cx="60"  cy="100" r="12" />
        <circle class="smoke-puff s3" cx="62"  cy="100" r="8"  />
        <circle class="smoke-puff s4" cx="100" cy="90"  r="11" />
        <circle class="smoke-puff s5" cx="100" cy="90"  r="13" />
        <circle class="smoke-puff s6" cx="140" cy="100" r="10" />

        <!-- Brewery building -->
        <!-- Main body -->
        <rect x="30" y="120" width="140" height="65" fill="#92400E" />
        <!-- Roof -->
        <polygon points="30,120 100,90 170,120" fill="#7C2D12" />
        <!-- Chimneys -->
        <rect x="55" y="100" width="14" height="35" fill="#7C2D12" />
        <rect x="93" y="90"  width="14" height="40" fill="#7C2D12" />
        <rect x="135" y="100" width="14" height="35" fill="#7C2D12" />
        <!-- Door -->
        <rect x="92" y="155" width="16" height="30" rx="2" fill="#FCD34D" />
        <!-- Windows -->
        <rect x="48" y="135" width="12" height="12" fill="#FCD34D" />
        <rect x="68" y="135" width="12" height="12" fill="#FCD34D" />
        <rect x="120" y="135" width="12" height="12" fill="#FCD34D" />
        <rect x="140" y="135" width="12" height="12" fill="#FCD34D" />
        <!-- Sign -->
        <rect x="80" y="145" width="40" height="6" rx="1" fill="#FEF3C7" />
    </svg>
</div>
