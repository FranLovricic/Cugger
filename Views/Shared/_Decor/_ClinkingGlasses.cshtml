@* Two beer glasses tilting and clinking with sparks at impact point *@
<div class="page-decor">
    <svg class="clink-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Sparks at impact point (between glasses) -->
        <g class="clink-spark s1">
            <polygon points="100,80 105,90 115,90 107,97 110,108 100,102 90,108 93,97 85,90 95,90" fill="#FCD34D" />
        </g>
        <g class="clink-spark s2">
            <circle cx="100" cy="90" r="4" />
        </g>
        <g class="clink-spark s3">
            <line x1="100" y1="65" x2="100" y2="50" stroke="#FCD34D" stroke-width="3" stroke-linecap="round" />
            <line x1="115" y1="80" x2="125" y2="73" stroke="#FCD34D" stroke-width="3" stroke-linecap="round" />
            <line x1="85" y1="80" x2="75" y2="73" stroke="#FCD34D" stroke-width="3" stroke-linecap="round" />
        </g>

        <!-- Left glass -->
        <g class="glass-left">
            <!-- Glass body -->
            <path d="M 35 100 L 40 175 L 80 175 L 85 100 Z"
                  fill="rgba(254, 243, 199, 0.12)"
                  stroke="rgba(254, 243, 199, 0.55)" stroke-width="2" />
            <!-- Liquid -->
            <path d="M 40 110 L 43 170 L 77 170 L 80 110 Z" fill="#F59E0B" opacity="0.9" />
            <!-- Foam -->
            <ellipse cx="60" cy="110" rx="22" ry="4" fill="#FEF3C7" />
            <!-- Handle -->
            <path d="M 85 115 Q 105 115, 105 140 Q 105 160, 85 160"
                  fill="none" stroke="rgba(254, 243, 199, 0.55)" stroke-width="3" />
        </g>

        <!-- Right glass -->
        <g class="glass-right">
            <path d="M 115 100 L 120 175 L 160 175 L 165 100 Z"
                  fill="rgba(254, 243, 199, 0.12)"
                  stroke="rgba(254, 243, 199, 0.55)" stroke-width="2" />
            <path d="M 120 110 L 123 170 L 157 170 L 160 110 Z" fill="#F59E0B" opacity="0.9" />
            <ellipse cx="140" cy="110" rx="22" ry="4" fill="#FEF3C7" />
            <path d="M 115 115 Q 95 115, 95 140 Q 95 160, 115 160"
                  fill="none" stroke="rgba(254, 243, 199, 0.55)" stroke-width="3" />
        </g>
    </svg>
</div>
