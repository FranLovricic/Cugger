<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cugger</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/cugger.css" />
</head>
<body>
    <!-- NAVIGATION -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                🍺 Cugger
            </a>
            <ul class="navbar-menu">
                <li>
                    <a href="/" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        Feed
                    </a>
                </li>
                <li>
                    <a href="/Beer" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Beer" ? "active" : "")">
                        Piva
                    </a>
                </li>
                <li>
                    <a href="/Brewery" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Brewery" ? "active" : "")">
                        Pivovare
                    </a>
                </li>
                <li>
                    <a href="/CheckIn" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "CheckIn" ? "active" : "")">
                        Check-ini
                    </a>
                </li>
                <li>
                    <a href="/User" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                        Korisnici
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main-container">
        <div class="container">
            @if (ViewBag.Breadcrumbs != null)
            {
                <div class="breadcrumb" style="padding-top: 1rem;">
                    @foreach (var item in ViewBag.Breadcrumbs)
                    {
                        <span class="breadcrumb-item">
                            @if (!item.IsCurrent)
                            {
                                <a href="@item.Url">@item.Title</a>
                            }
                            else
                            {
                                <span>@item.Title</span>
                            }
                        </span>
                    }
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">🍺 Cugger</div>
                    <p class="footer-desc">Vaša zajednica za otkrivanje, ocjenjivanje i dijeljenje iskustava s pivom.</p>
                </div>
                <div>
                    <div class="footer-heading">Istraži</div>
                    <ul class="footer-links">
                        <li><a href="/Beer">Piva</a></li>
                        <li><a href="/Brewery">Pivovare</a></li>
                        <li><a href="/Venue">Lokale</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-heading">Zajednica</div>
                    <ul class="footer-links">
                        <li><a href="/CheckIn">Check-ini</a></li>
                        <li><a href="/Review">Recenzije</a></li>
                        <li><a href="/Friendship">Prijateljstva</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-heading">Profil</div>
                    <ul class="footer-links">
                        <li><a href="/User">Korisnici</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Cugger — Svi piva su fiktivni.</span>
                <span>Napravljeno s 🍺</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
</body>
</html>
