<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cugger</title>
    <link rel="stylesheet" href="~/css/cugger.css" />
</head>
<body>
    <!-- NAVIGATION -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                🍺 Cugger
            </a>
            <ul class="navbar-menu">
                <li>
                    <a href="/" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        Dashboard
                    </a>
                </li>
                <li>
                    <a href="/Beer" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Beer" ? "active" : "")">
                        Piva
                    </a>
                </li>
                <li>
                    <a href="/Brewery" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Brewery" ? "active" : "")">
                        Pivovare
                    </a>
                </li>
                <li>
                    <a href="/CheckIn" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "CheckIn" ? "active" : "")">
                        Check-ini
                    </a>
                </li>
                <li>
                    <a href="/User" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                        Korisnici
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main-container">
        <div class="container">
            @if (ViewBag.Breadcrumbs != null)
            {
                <div class="breadcrumb">
                    @foreach (var item in ViewBag.Breadcrumbs)
                    {
                        <span class="breadcrumb-item">
                            @if (!item.IsCurrent)
                            {
                                <a href="@item.Url">@item.Title</a>
                            }
                            else
                            {
                                <span>@item.Title</span>
                            }
                        </span>
                    }
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Cugger - Untappd za programere. Svi piva su fiktivni.</p>
        </div>
    </footer>
</body>
</html>
