@model User

@{
    ViewData["Title"] = $"{Model?.FirstName} {Model?.LastName} - Profil";
    var checkIns = ViewBag.CheckIns as List<CheckIn>;
    var friends = ViewBag.Friends as List<User>;
    var reviews = ViewBag.Reviews as List<Review>;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div style="display: flex; gap: 2rem; align-items: flex-start;">
                <div class="avatar avatar-xl">
                    <img src="@Model.AvatarUrl" alt="@Model.FirstName" />
                </div>
                <div>
                    <div class="section-label">Profil</div>
                    <h1 class="header-title">@Model.FirstName @Model.LastName</h1>
                    <p style="color: var(--text-muted); margin-bottom: 1rem;">@@@Model.Username</p>

                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <p style="margin-bottom: 1.5rem; font-style: italic; color: var(--text-secondary);">@Model.Bio</p>
                    }

                    <div class="header-meta">
                        <div class="header-meta-item">
                            <span class="header-meta-label">Check-ini</span>
                            <span class="header-meta-value">@(checkIns?.Count ?? 0)</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Prijatelji</span>
                            <span class="header-meta-value">@(friends?.Count ?? 0)</span>
                        </div>
                        <div class="header-meta-item">
                            <span class="header-meta-label">Članstvo</span>
                            <span class="header-meta-value">@Model.RegistrationDate.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/User" class="btn btn-secondary">← Nazad</a>
        </div>
    </div>
</div>

<!-- CHECK-INS -->
<section class="section reveal">
    <div class="section-label">Aktivnost</div>
    <h2 class="section-title" style="font-size: 1.75rem;">Check-ini</h2>

    @if (checkIns?.Any() == true)
    {
        <div class="grid grid-2 stagger">
            @foreach (var checkIn in checkIns)
            {
                <a href="/CheckIn/Details/@checkIn.Id" style="text-decoration: none; color: inherit;">
                    <div class="checkin-card">
                        <div class="checkin-header">
                            <div class="checkin-user">
                                <div>
                                    <div class="checkin-user-name">@(checkIn.Beer?.Name ?? "Pivo")</div>
                                    <div class="checkin-user-time">@checkIn.CreatedAt.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                        </div>
                        <div class="checkin-beer">
                            <div class="checkin-beer-content">
                                <div class="checkin-beer-icon">🍻</div>
                                <div class="checkin-info">
                                    <div class="checkin-beer-name">📍 @(checkIn.Venue?.Name ?? "Lokacija")</div>
                                    @if (!string.IsNullOrEmpty(checkIn.Comment))
                                    {
                                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; font-style: italic;">"@checkIn.Comment"</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="checkin-footer">
                            <div class="checkin-rating"><span>★</span><span>@checkIn.Rating.ToString("F1")</span></div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty"><div class="section-empty-icon">📭</div><p>Nema check-inova.</p></div>
    }
</section>

<div class="divider"></div>

<!-- FRIENDS -->
<section class="section reveal">
    <div class="section-label">Društvo</div>
    <h2 class="section-title" style="font-size: 1.75rem;">Prijatelji</h2>

    @if (friends?.Any() == true)
    {
        <div class="grid grid-3 stagger">
            @foreach (var friend in friends)
            {
                <a href="/korisnik/@friend.Username" style="text-decoration: none; color: inherit;">
                    <div class="card">
                        <div class="card-body" style="text-align: center; padding: 2rem;">
                            <div class="avatar avatar-lg" style="margin: 0 auto 1rem;">
                                <img src="@friend.AvatarUrl" alt="@friend.FirstName" />
                            </div>
                            <h3 class="card-title" style="font-size: 1rem;">@friend.FirstName @friend.LastName</h3>
                            <p style="font-size: 0.85rem; color: var(--text-muted);">@@@friend.Username</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty"><div class="section-empty-icon">👤</div><p>Nema prijatelja.</p></div>
    }
</section>

<div class="divider"></div>

<!-- REVIEWS -->
<section class="section reveal">
    <div class="section-label">Recenzije</div>
    <h2 class="section-title" style="font-size: 1.75rem;">Moje recenzije</h2>

    @if (reviews?.Any() == true)
    {
        <div class="grid grid-2 stagger">
            @foreach (var review in reviews)
            {
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title" style="color: var(--primary); font-size: 0.95rem; margin-bottom: 0.5rem;">@(review.Beer?.Name ?? "Pivo")</h4>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: var(--warning); font-weight: 700;">★ @review.Rating.ToString("F1")</span>
                            <span style="color: var(--text-muted); font-size: 0.8rem;">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <p style="font-style: italic; color: var(--text-secondary);">@review.Comment</p>
                    </div>
                    <div class="card-footer">
                        <span style="font-size: 0.8rem; color: var(--text-muted);">👍 @review.Likes lajkova</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="section-empty"><div class="section-empty-icon">📝</div><p>Nema recenzija.</p></div>
    }
</section>
