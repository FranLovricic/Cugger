@model List<User>

@{
    ViewData["Title"] = "Korisnici - Cugger";
    ViewBag.Breadcrumbs = new[] {
        new { Title = "Dashboard", Url = "/", IsCurrent = false },
        new { Title = "Korisnici", Url = "/User", IsCurrent = true }
    };
}

<div class="page-header">
    <partial name="_Decor/_AvatarBubbles" />
    <div class="section-label">Ljudi</div>
    <h1 class="page-title">Korisnici</h1>
    <p class="page-subtitle">Nađi i prati druge ljubitelje piva.</p>
</div>

@if (Model?.Any() == true)
{
    <div class="card" style="margin-top: 1rem;">
        <ul class="list">
            @foreach (var user in Model)
            {
                <li class="list-item">
                    <div class="avatar avatar-md">
                        <img src="@user.AvatarUrl" alt="@user.FirstName" />
                    </div>
                    <a href="/korisnik/@user.Username">
                        <div class="list-item-content">
                            <div class="list-item-title">@user.FirstName @user.LastName</div>
                            <div class="list-item-subtitle">@@@user.Username</div>
                            @if (!string.IsNullOrEmpty(user.Bio))
                            {
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">@user.Bio</p>
                            }
                        </div>
                    </a>
                    <div class="list-item-meta">
                        <span>Članstvo od @user.RegistrationDate.ToString("MMM yyyy")</span>
                    </div>
                </li>
            }
        </ul>
    </div>
}
else
{
    <div class="section-empty"><div class="section-empty-icon">👤</div><p>Nema korisnika.</p></div>
}
