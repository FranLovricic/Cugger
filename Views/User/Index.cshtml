@model List<User>

@{
    ViewData["Title"] = "Korisnici - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_AvatarBubbles" />
    <div class="section-label">Ljudi</div>
    <h1 class="page-title">Korisnici</h1>
    <p class="page-subtitle">Nađi i prati druge ljubitelje piva.</p>
</div>

<form data-ajax-search="/api/search/users" data-target="#user-results" class="search-bar reveal" style="margin-bottom: 2rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži korisnika po imenu, prezimenu ili usernameu..."
        autocomplete="off" />
</form>

<div id="user-results">
    <partial name="_UserList" model="Model" />
</div>
