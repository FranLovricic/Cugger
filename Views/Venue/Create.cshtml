@model Cugger.Models.ViewModels.CreateVenueViewModel

@{
    ViewData["Title"] = "Dodaj lokal - Cugger";
}

<div class="auth-wrap" style="align-items: flex-start;">
    <div class="auth-card reveal" style="max-width: 640px;">
        <div class="section-label">Dodaj u katalog</div>
        <h1 class="auth-title">Novi lokal 📍</h1>
        <p class="auth-subtitle">Mjesto gdje rado piješ pivo? Reci nam za njega.</p>

        <form asp-action="Create" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-summary"></div>

            <div class="form-row">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-input" placeholder="npr. Pivnica Medvedgrad" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-input" placeholder="Ilica 1" />
                <span asp-validation-for="Address" class="form-error"></span>
            </div>

            <div class="form-row form-row-grid">
                <div>
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-input" placeholder="Zagreb" />
                    <span asp-validation-for="City" class="form-error"></span>
                </div>
                <div>
                    <label asp-for="Country" class="form-label"></label>
                    <input asp-for="Country" class="form-input" placeholder="Hrvatska" />
                    <span asp-validation-for="Country" class="form-error"></span>
                </div>
            </div>

            <div class="form-row form-row-grid">
                <div>
                    <label asp-for="Latitude" class="form-label"></label>
                    <input asp-for="Latitude" type="number" step="0.000001" class="form-input" placeholder="45.815" />
                    <span asp-validation-for="Latitude" class="form-error"></span>
                </div>
                <div>
                    <label asp-for="Longitude" class="form-label"></label>
                    <input asp-for="Longitude" type="number" step="0.000001" class="form-input" placeholder="15.982" />
                    <span asp-validation-for="Longitude" class="form-error"></span>
                </div>
            </div>

            <small style="display:block; margin-bottom: 1rem; color: var(--text-muted); font-size: 0.8rem;">
                💡 Koordinate možeš pronaći desnim klikom na lokaciju u Google Maps.
            </small>

            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                <a href="/Venue" class="btn btn-secondary" style="flex: 1;">Odustani</a>
                <button type="submit" class="btn btn-primary" style="flex: 2;">Spremi lokal →</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
