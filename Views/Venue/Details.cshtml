@model Venue

@{
    ViewData["Title"] = $"{Model?.Name} - Lokacija";
    var checkIns = ViewBag.CheckIns as List<CheckIn>;
    var checkInCount = ViewBag.CheckInCount as int? ?? 0;
}

<!-- HEADER -->
<div class="header">
    <div class="header-content">
        <div class="header-main">
            <div class="section-label">Lokacija</div>
            <h1 class="header-title">@Model.Name</h1>
            <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">📍 @Model.Address</p>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">@Model.City, @Model.Country</p>

            <div class="header-meta">
                <div class="header-meta-item">
                    <span class="header-meta-label">Check-ini</span>
                    <span class="header-meta-value">@checkInCount</span>
                </div>
                <div class="header-meta-item">
                    <span class="header-meta-label">Koordinate</span>
                    <span class="header-meta-value" style="font-size: 0.9rem;">@Model.Latitude, @Model.Longitude</span>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <a href="/Venue" class="btn btn-secondary">← Nazad</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Venue/Edit/@Model.Id" class="btn btn-ghost">Uredi</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;"
                      onsubmit="return confirm('Sigurno želiš obrisati ovaj lokal? (samo ako nema check-inova)');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Obriši</button>
                </form>
            }
        </div>
    </div>
</div>

<!-- CHECK-INS -->
<section class="section reveal">
    <div class="section-label">Aktivnost</div>
    <h2 class="section-title" style="font-size: 1.75rem;">Check-ini na ovoj lokaciji</h2>

    @if (checkIns?.Any() == true)
    {
        <div class="grid grid-2 stagger">
            @foreach (var checkIn in checkIns)
            {
                <a href="/CheckIn/Details/@checkIn.Id" style="text-decoration: none; color: inherit;">
                    <div class="checkin-card">
                        <div class="checkin-header">
                            <div class="checkin-user">
                                <div class="avatar avatar-sm">
                                    <img src="@(checkIn.User?.AvatarUrl ?? "https://ui-avatars.com/api/?name=User")" alt="@checkIn.User?.Username" />
                                </div>
                                <div>
                                    <div class="checkin-user-name">@(checkIn.User?.FirstName) @(checkIn.User?.LastName)</div>
                                    <div class="checkin-user-time">@checkIn.CreatedAt.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                        </div>
                        <div class="checkin-beer">
                            <div class="checkin-beer-content">
                                <div class="checkin-beer-icon">🍻</div>
                                <div class="checkin-info">
                                    <div class="checkin-beer-name">@(checkIn.Beer?.Name ?? "Pivo")</div>
                                    @if (!string.IsNullOrEmpty(checkIn.Comment))
                                    {
                                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; font-style: italic;">"@checkIn.Comment"</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="checkin-footer">
                            <div class="checkin-rating"><span>★</span><span>@checkIn.Rating.ToString("F1")</span></div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="section-empty"><div class="section-empty-icon">📭</div><p>Nema check-inova na ovoj lokaciji.</p></div>
    }
</section>
