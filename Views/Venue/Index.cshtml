@model List<Venue>

@{
    ViewData["Title"] = "Lokali - Cugger";
}

<div class="page-header">
    <partial name="_Decor/_VenuePin" />
    <div class="section-label">Mjesta</div>
    <h1 class="page-title">Lokali</h1>
    <p class="page-subtitle">Otkrij gdje se obavljaju check-ini.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="margin-top: 1.5rem;">
            <a href="/Venue/Create" class="btn btn-primary">+ Dodaj lokal</a>
        </div>
    }
</div>

<form data-ajax-search="/api/search/venues" data-target="#venue-results" class="search-bar reveal" style="margin-bottom: 2rem;">
    <input
        type="search"
        name="q"
        class="search-input"
        placeholder="🔍 Traži po imenu, gradu ili adresi..."
        autocomplete="off" />
</form>

<div id="venue-results">
    <partial name="_VenueGrid" model="Model" />
</div>
